# Add inside the `connecto.studio { ... }` block of the server's Caddyfile (and of
# the source that Caddyfile is deployed from, or the next deploy removes it
# again). Caddy 2.11.
#
# Logs only requests for the download files, one JSON line each, with no IP
# address, port or cookie. count-downloads.py reads these files. Downloads are
# few, so the file grows slowly; it is rolled at 50 MiB and the rolled files are
# kept (gzip) for ten years, because the total is recomputed from all of them.

	@not_a_download not path /downloads/*.dmg /downloads/*.zip
	log_skip @not_a_download
	log connecto_downloads {
		output file /config/logs/connecto-downloads.log {
			roll_size 50MiB
			roll_keep 1000
			roll_keep_for 87600h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Forwarded-For delete
				resp_headers delete
			}
		}
	}
